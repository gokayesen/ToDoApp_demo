// Prisma schema — auth/workspace/board containers (Epic 1-2), List/Card
// (Epic 3), Label/Checklist/Comment/Attachment/ActivityLog (Epic 4), and
// Notification/NotificationPreference (Epic 6) per Epics-and-Stories.md.
// Cascade behavior follows Architecture.md §4 "Referential Integrity & Cascade Strategy".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum BoardRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String? // nullable if OAuth-only
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  oauthAccounts           OAuthAccount[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  workspaceMemberships    WorkspaceMember[]
  boardMemberships        BoardMember[]
  sentWorkspaceInvites    WorkspaceInvite[]        @relation("WorkspaceInviteSender")
  sentBoardInvites        BoardInvite[]            @relation("BoardInviteSender")
  cardAssignments         CardAssignee[]
  comments                Comment[]
  attachments             Attachment[]
  activityLogEntries      ActivityLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime? // single-use marker

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  ownerId String @db.Uuid

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  boards  Board[]
  invites WorkspaceInvite[]
}

// Only created for an email with no existing User (Story 2.3, FR7) — inviting an
// already-registered email adds a WorkspaceMember row directly instead, since
// there's nothing left "pending" once the account already exists.
model WorkspaceInvite {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  email           String
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Board {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  name        String
  background  String?
  isArchived  Boolean @default(false)

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     BoardMember[]
  invites     BoardInvite[]
  lists       List[]
  labels      Label[]
  activityLog ActivityLog[]
}

model BoardMember {
  boardId String    @db.Uuid
  userId  String    @db.Uuid
  role    BoardRole

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// Only created for an email with no existing User (Story 2.5, FR9) — same
// pattern as WorkspaceInvite (Story 2.3): an already-registered email is added
// as a BoardMember directly, with the requested role, instead of going through
// a pending row.
model BoardInvite {
  id              String    @id @default(uuid()) @db.Uuid
  boardId         String    @db.Uuid
  email           String
  role            BoardRole
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("BoardInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

// Story 3.1 (FR14): create/rename/delete. position is written via the shared
// fractional-index engine (services/position.service.ts, Story 3.2); the
// reorder endpoint that moves an existing List between live neighbors lands
// in Story 3.5. isArchived is unused until Story 3.7 but included now to
// match the full data model in Architecture §4.
model List {
  id         String  @id @default(uuid()) @db.Uuid
  boardId    String  @db.Uuid
  name       String
  position   Float
  isArchived Boolean @default(false)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

// Story 3.1 (FR17): create with title, delete; position via the same shared
// engine as List (Story 3.2). description/startDate/dueDate are unused until
// Epic 4. isArchived gets its first writer in Story 3.7 (List archive cascade)
// ahead of Story 3.8's own direct per-Card archive/restore, but all are
// included now to match the full Card model in Architecture §4.
model Card {
  id                String    @id @default(uuid()) @db.Uuid
  listId            String    @db.Uuid
  title             String
  description       String?
  position          Float
  startDate         DateTime?
  dueDate           DateTime?
  isArchived        Boolean   @default(false)
  // Story 3.7 (FR16): set alongside isArchived when a List archive cascades
  // to this Card, cleared when that cascade is undone by restoring the List.
  // Distinguishes "archived because its List was archived" from a future
  // direct per-Card archive (Story 3.8), so restoring a List only brings back
  // Cards it cascade-archived — one a user independently archived beforehand
  // stays archived.
  archivedWithList  Boolean   @default(false)
  // Story 5.6 (FR33): optimistic-concurrency check for the "just updated by
  // X" conflict signal (UX §6) — bumped on every scalar-field update to this
  // row (title/description/dates/position/isArchived), not on join-table
  // changes (labels/assignees/checklists) which don't touch the Card row
  // itself. Not in Architecture §4's ER diagram, which never modeled
  // conflict detection — same kind of gap-fill as archivedWithList above.
  updatedAt         DateTime  @updatedAt
  // Story 6.4 (FR34/NFR5): idempotency guards for jobs/due-date-sweep.ts —
  // null means "not yet notified for the current dueDate value". Both are
  // reset to null in card.service.ts updateCard whenever dueDate actually
  // changes, so a rescheduled due date can trigger fresh notifications.
  // Another gap-fill not in Architecture §4's ER diagram, same rationale as
  // archivedWithList/updatedAt above.
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?

  list        List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels      CardLabel[]
  assignees   CardAssignee[]
  checklists  Checklist[]
  comments    Comment[]
  attachments Attachment[]
  activityLog ActivityLog[]

  @@index([listId])
}

// Story 4.6 (FR27): one or more per Card. position uses the same shared
// fractional-index engine as List/Card (services/position.service.ts); new
// Checklists append at the end, same as new Lists/Cards — no reorder-
// checklist endpoint exists yet since the story only calls for reordering
// items within a checklist, not the checklists themselves.
model Checklist {
  id       String @id @default(uuid()) @db.Uuid
  cardId   String @db.Uuid
  title    String
  position Float

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId])
}

model ChecklistItem {
  id          String  @id @default(uuid()) @db.Uuid
  checklistId String  @db.Uuid
  text        String
  isChecked   Boolean @default(false)
  position    Float

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

// Story 4.7 (FR28): body is a plain-text convention — a mention is literally
// `@Full Name` typed via the composer's autocomplete (packages/shared has no
// dedicated mention schema; the Architecture §4 ER diagram doesn't define one
// either) and re-highlighted client-side by matching against the board's
// current member names. No notification wiring here: Notification doesn't
// exist until Epic 6 (Story 6.1/6.3 is what would consume this later).
// userId is nullable + authorNameSnapshot denormalized per Architecture §4's
// cascade table (SetNull, not Cascade, on user deletion) so a comment
// survives its author's account being deleted — shared board history, same
// rationale as Attachment.uploaderId/ActivityLog.userId.
model Comment {
  id                 String   @id @default(uuid()) @db.Uuid
  cardId             String   @db.Uuid
  userId             String?  @db.Uuid
  authorNameSnapshot String
  body               String
  createdAt          DateTime @default(now())

  card Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId])
}

// Story 4.8 (FR29): direct-to-R2 presigned upload (Architecture §3/§9) — the
// API never proxies file bytes, only issues a presigned PUT URL and then
// records the resulting object's public URL here once the client's direct
// upload succeeds. uploaderId/uploaderNameSnapshot follow the same SetNull +
// denormalized-snapshot pattern as Comment.userId/authorNameSnapshot
// (Architecture §4 cascade table). createdAt isn't in the Architecture §4 ER
// diagram's Attachment block (unlike Comment/ActivityLog, which both have
// one) but chronological attachment ordering needs it — same kind of small,
// safe gap-fill as Story 3.9's archivedWithList fix.
model Attachment {
  id                   String   @id @default(uuid()) @db.Uuid
  cardId               String   @db.Uuid
  uploaderId           String?  @db.Uuid
  uploaderNameSnapshot String
  fileUrl              String
  fileName             String
  fileSize             Int
  mimeType             String
  createdAt            DateTime @default(now())

  card     Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([cardId])
}

// Story 4.9 (FR30): system-generated entries interleaved with Comments in
// Card Detail's Activity feed (UX §4.3). boardId is required (every entry
// belongs to a Board) while cardId is nullable — this story only ever writes
// card-scoped entries, but the model leaves room for board-level activity
// (e.g. membership changes) that no current story populates yet, matching
// Architecture §4's ER diagram exactly. `type` is a fixed string key (see
// packages/shared's activityTypeSchema enum) with a freeform `metadata` JSON
// payload shaped per type — same "string + Zod-validated enum, not a DB
// enum" choice as Label.color. userId/actorNameSnapshot follow the same
// SetNull + denormalized-snapshot pattern as Comment.userId. cardId is
// SetNull (not Cascade) on Card deletion — per Architecture §4's stated
// rationale for the User-facing SetNull relations ("preserves shared board
// history... including the audit trail itself"), a Card's own deletion
// shouldn't erase the board's history of what happened to it, only orphan
// the specific card reference.
model ActivityLog {
  id                String   @id @default(uuid()) @db.Uuid
  boardId           String   @db.Uuid
  cardId            String?  @db.Uuid
  userId            String?  @db.Uuid
  actorNameSnapshot String
  type              String
  metadata          Json
  createdAt         DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([cardId])
}

// Story 4.3 (FR24): per-board Label taxonomy (name + color, `color` a fixed
// palette key from packages/shared's LABEL_COLORS — validated at the Zod
// schema boundary, not a DB constraint) attached/removed on Cards via the
// CardLabel join below.
model Label {
  id      String @id @default(uuid()) @db.Uuid
  boardId String @db.Uuid
  name    String
  color   String

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@index([boardId])
}

// Plain many-to-many join, no attributes of its own — cascades from either
// side per Architecture §4 (compositional data has no meaning once its
// parent is gone).
model CardLabel {
  cardId  String @db.Uuid
  labelId String @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Story 4.5 (FR26): assigns a Board Member to a Card. Same plain-join shape
// as CardLabel; Architecture §4's cascade table lists CardAssignee -> User as
// Cascade ("pure membership row"), same rationale as BoardMember/WorkspaceMember.
model CardAssignee {
  cardId String @db.Uuid
  userId String @db.Uuid

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Story 6.1 (FR34/FR36): in-app notifications for a recipient User. `type` is
// a plain string (not a Zod enum like ActivityLog.type) because no story
// writes a Notification row yet — the concrete trigger set (assignment,
// @mention, due-date sweep, board/workspace add) is Story 6.3's job, and
// enumerating values with zero producers here would be speculative. `payload`
// is freeform JSON shaped per type, same "string key + JSON payload"
// convention as ActivityLog.metadata. Cascades on User delete (not SetNull)
// per Architecture §4's cascade table rationale for RefreshToken/
// PasswordResetToken: "purely personal, never shared with other users" — a
// notification only exists for its one recipient, unlike Comment/ActivityLog
// which are shared board history.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Story 6.1 (FR35/FR36 preface, consumed by Story 6.6's settings screen):
// per-(user, eventType) email/in-app opt-out. No row for a given eventType
// means "defaults enabled" (both flags default true) — rows are only
// materialized when a user actually changes a preference away from the
// default, so this table starts empty and Story 6.3/6.5's senders must treat
// a missing row as enabled rather than requiring one to pre-exist.
model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  eventType    String
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}
