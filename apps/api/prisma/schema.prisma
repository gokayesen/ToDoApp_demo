// Prisma schema — auth/workspace/board containers (Epic 1-2) plus List/Card
// (Epic 3). Label/Checklist/Comment/Attachment/ActivityLog/Notification models
// are added in later epics (4, 6) per Epics-and-Stories.md.
// Cascade behavior follows Architecture.md §4 "Referential Integrity & Cascade Strategy".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum BoardRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String? // nullable if OAuth-only
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  boardMemberships     BoardMember[]
  sentWorkspaceInvites WorkspaceInvite[]     @relation("WorkspaceInviteSender")
  sentBoardInvites     BoardInvite[]         @relation("BoardInviteSender")
  cardAssignments      CardAssignee[]
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime? // single-use marker

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  ownerId String @db.Uuid

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  boards  Board[]
  invites WorkspaceInvite[]
}

// Only created for an email with no existing User (Story 2.3, FR7) — inviting an
// already-registered email adds a WorkspaceMember row directly instead, since
// there's nothing left "pending" once the account already exists.
model WorkspaceInvite {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  email           String
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Board {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  name        String
  background  String?
  isArchived  Boolean @default(false)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   BoardMember[]
  invites   BoardInvite[]
  lists     List[]
  labels    Label[]
}

model BoardMember {
  boardId String    @db.Uuid
  userId  String    @db.Uuid
  role    BoardRole

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// Only created for an email with no existing User (Story 2.5, FR9) — same
// pattern as WorkspaceInvite (Story 2.3): an already-registered email is added
// as a BoardMember directly, with the requested role, instead of going through
// a pending row.
model BoardInvite {
  id              String    @id @default(uuid()) @db.Uuid
  boardId         String    @db.Uuid
  email           String
  role            BoardRole
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("BoardInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

// Story 3.1 (FR14): create/rename/delete. position is written via the shared
// fractional-index engine (services/position.service.ts, Story 3.2); the
// reorder endpoint that moves an existing List between live neighbors lands
// in Story 3.5. isArchived is unused until Story 3.7 but included now to
// match the full data model in Architecture §4.
model List {
  id         String  @id @default(uuid()) @db.Uuid
  boardId    String  @db.Uuid
  name       String
  position   Float
  isArchived Boolean @default(false)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

// Story 3.1 (FR17): create with title, delete; position via the same shared
// engine as List (Story 3.2). description/startDate/dueDate are unused until
// Epic 4. isArchived gets its first writer in Story 3.7 (List archive cascade)
// ahead of Story 3.8's own direct per-Card archive/restore, but all are
// included now to match the full Card model in Architecture §4.
model Card {
  id          String    @id @default(uuid()) @db.Uuid
  listId      String    @db.Uuid
  title       String
  description String?
  position    Float
  startDate   DateTime?
  dueDate     DateTime?
  isArchived  Boolean   @default(false)
  // Story 3.7 (FR16): set alongside isArchived when a List archive cascades
  // to this Card, cleared when that cascade is undone by restoring the List.
  // Distinguishes "archived because its List was archived" from a future
  // direct per-Card archive (Story 3.8), so restoring a List only brings back
  // Cards it cascade-archived — one a user independently archived beforehand
  // stays archived.
  archivedWithList Boolean @default(false)

  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels    CardLabel[]
  assignees CardAssignee[]

  @@index([listId])
}

// Story 4.3 (FR24): per-board Label taxonomy (name + color, `color` a fixed
// palette key from packages/shared's LABEL_COLORS — validated at the Zod
// schema boundary, not a DB constraint) attached/removed on Cards via the
// CardLabel join below.
model Label {
  id      String @id @default(uuid()) @db.Uuid
  boardId String @db.Uuid
  name    String
  color   String

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@index([boardId])
}

// Plain many-to-many join, no attributes of its own — cascades from either
// side per Architecture §4 (compositional data has no meaning once its
// parent is gone).
model CardLabel {
  cardId  String @db.Uuid
  labelId String @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Story 4.5 (FR26): assigns a Board Member to a Card. Same plain-join shape
// as CardLabel; Architecture §4's cascade table lists CardAssignee -> User as
// Cascade ("pure membership row"), same rationale as BoardMember/WorkspaceMember.
model CardAssignee {
  cardId String @db.Uuid
  userId String @db.Uuid

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}
