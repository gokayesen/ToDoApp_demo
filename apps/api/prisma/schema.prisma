// Prisma schema — Epic 1 scope only (auth + workspace/board containers).
// List/Card/Label/Checklist/Comment/Attachment/ActivityLog/Notification models
// are added in later epics (3, 4, 6) per Epics-and-Stories.md.
// Cascade behavior follows Architecture.md §4 "Referential Integrity & Cascade Strategy".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum BoardRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String? // nullable if OAuth-only
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  boardMemberships     BoardMember[]
  sentWorkspaceInvites WorkspaceInvite[]     @relation("WorkspaceInviteSender")
  sentBoardInvites     BoardInvite[]         @relation("BoardInviteSender")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime? // single-use marker

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  ownerId String @db.Uuid

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  boards  Board[]
  invites WorkspaceInvite[]
}

// Only created for an email with no existing User (Story 2.3, FR7) — inviting an
// already-registered email adds a WorkspaceMember row directly instead, since
// there's nothing left "pending" once the account already exists.
model WorkspaceInvite {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  email           String
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Board {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  name        String
  background  String?
  isArchived  Boolean @default(false)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   BoardMember[]
  invites   BoardInvite[]
}

model BoardMember {
  boardId String    @db.Uuid
  userId  String    @db.Uuid
  role    BoardRole

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// Only created for an email with no existing User (Story 2.5, FR9) — same
// pattern as WorkspaceInvite (Story 2.3): an already-registered email is added
// as a BoardMember directly, with the requested role, instead of going through
// a pending row.
model BoardInvite {
  id              String    @id @default(uuid()) @db.Uuid
  boardId         String    @db.Uuid
  email           String
  role            BoardRole
  invitedByUserId String    @db.Uuid
  tokenHash       String
  expiresAt       DateTime
  acceptedAt      DateTime? // single-use marker, set when registration resolves this invite

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("BoardInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}
